     {
      "type": "function",
      "function": {
       "name": "repo_read",
       "description": "Read a GitHub repository. op: file (path, optional lines \"a-b\"; a directory path lists it), tree (all file paths, optional path prefix), log (optional path, n), diff (base, head, optional path), branches, prs (state). ref is a branch, tag or commit; default branch if omitted. Say in `want` what you are looking for when the output may be long.",
       "parameters": {
        "type": "object",
        "properties": {
         "repo": {
          "type": "string",
          "description": "owner/name"
         },
         "op": {
          "type": "string",
          "enum": [
           "file",
           "tree",
           "log",
           "diff",
           "branches",
           "prs"
          ]
         },
         "path": {
          "type": "string"
         },
         "ref": {
          "type": "string"
         },
         "lines": {
          "type": "string"
         },
         "n": {
          "type": "integer"
         },
         "base": {
          "type": "string"
         },
         "head": {
          "type": "string"
         },
         "state": {
          "type": "string"
         },
         "want": {
          "type": "string"
         }
        },
        "required": [
         "repo"
        ]
       }
      }
     },
     {
      "type": "function",
      "function": {
       "name": "repo_commit",
       "description": "Commit changes to a branch in one commit; the branch is created from `from` (default branch if omitted) when it does not exist. Each change is {path, content}, {path, edits: [{find, replace}]} (each find must occur exactly once in the current file; prefer this for small changes), {path, from: \"os:...\"} or {path, delete: true}. The user approves each commit. An earlier call may appear as {ref, name}: its arguments are stored under that handle and are implied; calling with {ref} repeats it.",
       "parameters": {
        "type": "object",
        "properties": {
         "repo": {
          "type": "string"
         },
         "branch": {
          "type": "string"
         },
         "from": {
          "type": "string"
         },
         "message": {
          "type": "string"
         },
         "changes": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "path": {
             "type": "string"
            },
            "content": {
             "type": "string"
            },
            "from": {
             "type": "string",
             "description": "an os: handle whose stored text becomes the file"
            },
            "edits": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "find": {
                "type": "string"
               },
               "replace": {
                "type": "string"
               }
              },
              "required": [
