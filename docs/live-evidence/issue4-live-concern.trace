               "replace"
              ]
             }
            },
            "delete": {
             "type": "boolean"
            }
           },
           "required": [
            "path"
           ]
          }
         },
         "ref": {
          "type": "string"
         },
         "name": {
          "type": "string",
          "description": "short name for this call, kept as its label"
         }
        },
        "required": []
       }
      }
     },
     {
      "type": "function",
      "function": {
       "name": "repo_pr",
       "description": "Open a pull request from head into base (default branch if omitted). The user approves it.",
