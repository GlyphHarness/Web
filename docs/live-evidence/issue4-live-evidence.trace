         "arguments": "{\"code\": \"let sum = 0;\\nfor (let i = 1; i <= 20; i++) {\\n  sum += i * i;\\n}\\nreturn sum;\", \"want\": \"the sum of squares\"}"
        }
       }
      ]
     },
